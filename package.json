{
  "name": "color-trickser",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "biome check --write . && tsc -b && vitest run",
    "check": "biome check . && tsc -b && vitest run && tsx scripts/check-licenses.ts",
    "format": "biome format --write .",
    "deploy": "pnpm run build && wrangler deploy",
    "licenses": "tsx scripts/check-licenses.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/libre-baskerville": "^5.3.0",
    "@huggingface/transformers": "^4.2.0",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "color-description": "^0.23.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.141.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "onnxruntime-node",
      "protobufjs",
      "sharp"
    ]
  },
  "license": "MIT"
}
